{
  "manifest_version": 3,
  "name": "DL Image Tools",
  "version": "1.0.0",
  "description": "Compress, resize, convert, crop and optimize images directly in Chrome. Fast. Private. No uploads.",
  "author": "DhivaLabs",
  "minimum_chrome_version": "110",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "DL Image Tools"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "downloads"
  ]
}
